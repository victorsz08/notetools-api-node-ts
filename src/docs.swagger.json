{
    "openapi": "3.0.0",
    "info": {
        "title": "Notetools Api",
        "description": "Api de aplicação de gestão de pedidos",
        "version": "2.0.1",
        "contact": {
            "name": "Victor Siqueira Developer",
            "email": "victorszdeveloper@gmail.com",
            "url": "https://github.com/victorsz08"
        }
    },
    "servers": [
        {
            "url": "http://localhost:3000",
            "description": "Servidor em desenvolvimento"
        }
    ],
    "components": {
        "securitySchemes": {
            "cookieAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "nt.authtoken"
            }
        },
        "schemas": {
            "User": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string",
                        "format": "uuid"
                    },
                    "username": {
                        "type": "string"
                    },
                    "firstName": {
                        "type": "string"
                    },
                    "lastName": {
                        "type": "string"
                    },
                    "role": {
                        "type": "string",
                        "enum": ["USER", "ADMIN"]
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "BadRequest": {
                "type": "object",
                "properties": {
                    "message": {
                        "type": "string"
                    },
                    "errors": {
                        "type": "array",
                        "items": {
                            "properties": {
                                "path": {
                                    "type": "string"
                                },
                                "message": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "paths": {
        "/users": {
            "post": {
                "summary": "Criar um novo usuário",
                "tags": ["Usuários"],
                "security": [{ "cookieAuth": ["nt.authtoken"] }],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "username": {
                                        "type": "string"
                                    },
                                    "firstName": {
                                        "type": "string"
                                    },
                                    "lastName": {
                                        "type": "string"
                                    },
                                    "password": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Criado"
                    },
                    "401": {
                        "description": "Dados inválidos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BadRequest"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Conflito",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Username indisponível"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/list-users": {
            "get": {
                "summary": "Listar todos os usuários",
                "security": [{ "cookieAuth": ["nt.authtoken"] }],
                "tags": ["Usuários"],
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "default": 1
                        }
                    },
                    {
                        "name": "limit",
                        "in": "query",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "default": 10
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Buscar em nome, username ou sobrenome",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "users": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/User"
                                            }
                                        },
                                        "total": {
                                            "type": "integer"
                                        },
                                        "page": {
                                            "type": "integer"
                                        },
                                        "limit": {
                                            "type": "integer"
                                        },
                                        "totalPages": {
                                            "type": "integer"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Não autorizado"
                    },
                    "403": {
                        "description": "Sem permissão para acessar essa rota"
                    }
                }
            }
        },
        "/users/{id}": {
            "get": {
                "summary": "Buscar usuário por id",
                "tags": ["Usuários"],
                "security": [{ "cookieAuth": ["nt.authtoken"] }],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Usuário não encontrado",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Usuário não localizado com esse id"
                                }
                            }
                        }
                    }
                }
            },
            "put": {
                "summary": "Atualizar informações do usuário",
                "tags": ["Usuários"],
                "security": [{ "coolieAuth": ["nt.authtoken"] }],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "username": {
                                        "type": "string"
                                    },
                                    "firstName": {
                                        "type": "string"
                                    },
                                    "lastName": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Dados inválidos",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/BadRequest"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Usuário não encontrado",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Usuário não localizado com esse id"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Username indisponível",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Username indisponível"
                                }
                            }
                        }
                    }
                }
            },
            "delete": {
                "summary": "Excluir um usuário",
                "tags": ["Usuários"],
                "security": [{ "cookieAuth": ["nt.authtoken"] }],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "404": {
                        "description": "Usuário não encontrado",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Usuário não localizado com esse id"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/users/update-password/{id}": {
            "put": {
                "summary": "Atualizar senha do usuário",
                "tags": ["Usuários"],
                "security": [{ "cookieAuth": ["nt.authtoken"] }],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "properties": {
                                    "currentPassword": {
                                        "type": "string"
                                    },
                                    "newPassword": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "OK"
                    },
                    "400": {
                        "description": "Dados invalidos",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Senha atual incorreta"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Usuário não encontrado",
                        "content": {
                            "application/json": {
                                "example": {
                                    "message": "Usuário não localizado com esse id"
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
